[Unit]
Description=Loopback VNC for Rutracker Chromium
After=rutracker-browser-xvfb.service
Requires=rutracker-browser-xvfb.service

[Service]
Type=simple
User=movie
Group=movie
ExecStartPre=/bin/sh -c 'until test -S /tmp/.X11-unix/X99; do sleep 0.1; done'
ExecStart=/usr/bin/x11vnc -display :99 -localhost -rfbport 5901 -forever -shared -nopw
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
