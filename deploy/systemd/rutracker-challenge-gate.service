# Loopback token gate for the Cloudflare-challenge noVNC page
# (rtcc.wildcar.org). The Telegram bot writes a one-time token to
# /var/lib/rutracker-challenge/token; nginx auth_request asks this gate
# whether a visitor's link/cookie matches it. See deploy/challenge-gate.py.
[Unit]
Description=Token gate for the rutracker challenge noVNC page
After=network.target

[Service]
Type=simple
User=movie
Group=movie
Environment=RUTRACKER_CHALLENGE_TOKEN_PATH=/var/lib/rutracker-challenge/token
ExecStart=/usr/bin/python3 /opt/rutracker-torrent-mcp/deploy/challenge-gate.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# Reads the token file only; ProtectSystem=strict already leaves it readable.
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
