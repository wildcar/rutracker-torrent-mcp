[Unit]
Description=SOCKS5 tunnel for rutracker-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=movie
Group=movie
ExecStart=/usr/bin/ssh -NT -D 127.0.0.1:1080 \
    -i /var/lib/rutracker-proxy/id_ed25519 \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o IdentitiesOnly=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile=/var/lib/rutracker-proxy/known_hosts \
    keeper@212.192.223.34
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
