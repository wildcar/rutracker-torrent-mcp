[Unit]
Description=Virtual display for persistent Rutracker Chromium
After=network.target

[Service]
Type=simple
User=movie
Group=movie
ExecStart=/usr/bin/Xvfb :99 -screen 0 1440x900x24 -nolisten tcp
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
